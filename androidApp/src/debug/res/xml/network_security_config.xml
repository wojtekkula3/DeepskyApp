<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: trusts user-installed CAs so a proxy such as Proxyman can decrypt the APOD traffic. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
